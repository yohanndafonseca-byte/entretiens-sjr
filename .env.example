# Base de données : fichier local en dev, Turso en production
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Secret de signature des sessions (32+ caractères aléatoires)
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# URL publique de l'application (liens dans les e-mails)
APP_URL=http://localhost:3000

# Envoi des e-mails (laisser vide = e-mails seulement journalisés dans l'application)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ressources Humaines <rh@ville-saintjeandelaruelle.fr>"

# Secret pour la tâche planifiée de relances (Vercel Cron)
CRON_SECRET=change-moi
